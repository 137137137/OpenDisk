    "Adds a gray wedge for unused space when viewing the whole disk. Turn off on large, mostly empty drives so scanned folders fill the chart." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يضيف شريحة رمادية للمساحة غير المستخدمة عند عرض القرص بالكامل. أوقف تشغيله في الأقراص الكبيرة شبه الفارغة لكي تملأ المجلدات التي تم فحصها المخطط."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Afegeix un sector gris per a l’espai sense utilitzar quan es mostra tot el disc. Desactiva-ho en discos grans i gairebé buits perquè les carpetes analitzades omplin el gràfic."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Při zobrazení celého disku přidá šedou výseč pro volné místo. Na velkých, převážně prázdných discích ji vypněte, aby graf vyplnily naskenované složky."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tilføjer et gråt segment for ubrugt plads, når hele disken vises. Slå fra på store, næsten tomme drev, så de scannede mapper fylder diagrammet."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fügt bei Anzeige des gesamten Volumes ein graues Segment für freien Speicher hinzu. Bei großen, weitgehend leeren Laufwerken deaktivieren, damit die gescannten Ordner das Diagramm füllen."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Προσθέτει ένα γκρι τμήμα για τον αχρησιμοποίητο χώρο όταν προβάλλεται ολόκληρος ο δίσκος. Απενεργοποιήστε το σε μεγάλους, σχεδόν άδειους δίσκους, ώστε οι σαρωμένοι φάκελοι να γεμίζουν το γράφημα."
          }
        },
        "en-AU" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Adds a grey wedge for unused space when viewing the whole disk. Turn off on large, mostly empty drives so scanned folders fill the chart."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Adds a grey wedge for unused space when viewing the whole disk. Turn off on large, mostly empty drives so scanned folders fill the chart."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Añade una porción gris para el espacio sin usar al ver el disco completo. Desactívalo en unidades grandes y casi vacías para que las carpetas escaneadas llenen el gráfico."
          }
        },
        "es-419" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Agrega una porción gris para el espacio sin usar al ver el disco completo. Desactívalo en unidades grandes y casi vacías para que las carpetas escaneadas llenen el gráfico."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lisää harmaan sektorin käyttämättömälle tilalle, kun koko levy näytetään. Laita pois päältä suurilla, lähes tyhjillä asemilla, jotta skannatut kansiot täyttävät kaavion."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ajoute un secteur gris pour l’espace inutilisé lorsque le disque entier est affiché. Désactivez cette option sur les disques volumineux et presque vides pour que les dossiers analysés remplissent le graphique."
          }
        },
        "fr-CA" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ajoute un secteur gris pour l’espace inutilisé lorsque le disque entier est affiché. Désactivez cette option sur les disques volumineux et presque vides pour que les dossiers analysés remplissent le graphique."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "מוסיף פלח אפור עבור שטח לא מנוצל בעת הצגת הדיסק כולו. כדאי לכבות זאת בכוננים גדולים וריקים ברובם, כדי שהתיקיות שנסרקו ימלאו את התרשים."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "पूरी डिस्क देखते समय अप्रयुक्त स्पेस के लिए एक ग्रे खंड जोड़ता है। बड़ी, ज़्यादातर ख़ाली ड्राइव पर इसे बंद करें ताकि स्कैन किए गए फ़ोल्डर पूरे चार्ट में दिखें।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dodaje sivi isječak za slobodan prostor pri prikazu cijelog diska. Isključite na velikim, uglavnom praznim diskovima kako bi skenirane mape ispunile grafikon."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A teljes lemez megtekintésekor szürke cikket jelenít meg a nem használt területhez. Nagy, többnyire üres meghajtókon kapcsolja ki, hogy a beolvasott mappák kitöltsék a diagramot."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Menambahkan irisan abu-abu untuk ruang yang tidak terpakai saat melihat seluruh disk. Matikan untuk drive besar yang sebagian besar kosong agar folder yang dipindai memenuhi bagan."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aggiunge uno spicchio grigio per lo spazio inutilizzato quando visualizzi l’intero disco. Disattiva l’opzione sulle unità grandi e quasi vuote affinché le cartelle analizzate riempiano il grafico."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ディスク全体を表示しているときに、未使用領域をグレーの扇形で表示します。容量が大きくほとんど空のドライブでは、オフにするとスキャンしたフォルダがチャート全体に表示されます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "디스크 전체를 볼 때 사용하지 않는 공간을 회색 조각으로 표시합니다. 용량이 크고 대부분 비어 있는 드라이브에서는 이 옵션을 끄면 스캔한 폴더가 차트를 채웁니다."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Menambah hirisan kelabu untuk ruang yang tidak digunakan apabila melihat keseluruhan cakera. Matikan untuk pemacu besar yang kebanyakannya kosong supaya folder yang diimbas memenuhi carta."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Legger til et grått segment for ubrukt plass når hele disken vises. Slå av på store, nesten tomme disker slik at de skannede mappene fyller diagrammet."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Voegt een grijs segment toe voor ongebruikte ruimte bij weergave van de hele schijf. Zet dit uit bij grote, grotendeels lege schijven zodat de gescande mappen het diagram vullen."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dodaje szary wycinek oznaczający wolne miejsce podczas wyświetlania całego dysku. Wyłącz na dużych, prawie pustych dyskach, aby wykres wypełniały przeskanowane katalogi."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Adiciona uma fatia cinza para o espaço não utilizado ao visualizar o disco inteiro. Desative em unidades grandes e quase vazias para que as pastas escaneadas preencham o gráfico."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Adiciona uma fatia cinzenta para o espaço não utilizado ao ver o disco inteiro. Desative em unidades grandes e quase vazias para que as pastas analisadas preencham o gráfico."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Adaugă un sector gri pentru spațiul neutilizat când este afișat întregul disc. Dezactivați opțiunea pe unitățile mari și aproape goale, astfel încât dosarele scanate să umple graficul."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Добавляет серый сектор для свободного места при просмотре всего диска. Выключите для больших, почти пустых дисков, чтобы диаграмму заполняли просканированные папки."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pri zobrazení celého disku pridá sivý výsek pre voľné miesto. Na veľkých, prevažne prázdnych diskoch ho vypnite, aby graf vyplnili naskenované priečinky."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lägger till ett grått segment för ledigt utrymme när hela skivan visas. Stäng av på stora, nästan tomma enheter så att de skannade mapparna fyller diagrammet."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "เพิ่มส่วนสีเทาสำหรับพื้นที่ที่ไม่ได้ใช้เมื่อดูทั้งดิสก์ ปิดตัวเลือกนี้สำหรับไดรฟ์ขนาดใหญ่ที่ส่วนใหญ่ว่างอยู่ เพื่อให้โฟลเดอร์ที่สแกนแสดงเต็มแผนภูมิ"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Diskin tamamı görüntülenirken kullanılmayan alan için gri bir dilim ekler. Taranan klasörlerin grafiği doldurması için büyük ve çoğunlukla boş disklerde kapatın."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Додає сірий сектор для вільного місця під час перегляду всього диска. Вимкніть для великих, майже порожніх дисків, щоб діаграму заповнювали проскановані папки."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Thêm một phần màu xám cho dung lượng chưa dùng khi xem toàn bộ ổ đĩa. Tắt tùy chọn này với các ổ lớn, gần như trống để các thư mục đã quét lấp đầy biểu đồ."
          }
        },
        "zh-HK" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "檢視整個磁碟時，以灰色扇形顯示未使用的空間。在容量大且大部分為空的磁碟上，關閉此選項可讓掃描的資料夾填滿圖表。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "查看整个磁盘时，用灰色扇区表示未使用的空间。对于容量大且大部分为空的驱动器，关闭此选项可让扫描的文件夹填满图表。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "檢視整個磁碟時，以灰色扇形顯示未使用的空間。在容量大且大部分為空的磁碟上，關閉此選項可讓掃描的檔案夾填滿圖表。"
          }
        }
      }
    },
