    "Please quit OpenDisk and drag it into the Applications folder yourself." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يرجى إنهاء OpenDisk وسحبه بنفسك إلى مجلد التطبيقات."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Surt d’OpenDisk i arrossega’l tu mateix a la carpeta Aplicacions."
          }
        },
        "cs" : {
          "stringUnit" : {
