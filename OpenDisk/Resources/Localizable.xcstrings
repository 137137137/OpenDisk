    "After granting access, click 'Check Again' to verify." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "بعد منح الوصول، انقر على «التحقق مجددًا» للتأكد."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Després de concedir l’accés, fes clic a «Tornar a comprovar» per verificar-ho."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Po udělení přístupu klikněte na „Zkontrolovat znovu“."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Når du har givet adgang, skal du klikke på ”Tjek igen” for at bekræfte."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Klicke nach dem Erteilen des Zugriffs zur Bestätigung auf „Erneut prüfen“."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Αφού παραχωρήσετε πρόσβαση, κάντε κλικ στο «Νέος έλεγχος» για επαλήθευση."
          }
        },
        "en-AU" : {
          "stringUnit" : {
            "state" : "translated",
