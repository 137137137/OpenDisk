          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "After granting access, click 'Check Again' to verify."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tras conceder el acceso, haz clic en «Volver a comprobar» para verificarlo."
          }
        },
        "es-419" : {
          "stringUnit" : {
            "state" : "translated",
