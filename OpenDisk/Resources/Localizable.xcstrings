    "Click a shortcut, then press the keys you want. Shortcuts apply while the file list is focused and never while typing in search." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "انقر على اختصار، ثم اضغط على المفاتيح التي تريدها. تعمل الاختصارات عندما تكون قائمة الملفات نشطة، ولا تعمل أبدًا أثناء الكتابة في البحث."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fes clic en una drecera i prem les tecles que vulguis. Les dreceres funcionen quan la llista de fitxers està activa, i mai mentre escrius a la cerca."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Klikněte na zkratku a stiskněte požadované klávesy. Zkratky fungují, když je aktivní seznam souborů, a nikdy při psaní do vyhledávání."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Klik på en genvej, og tryk derefter på de ønskede taster. Genveje virker, når fillisten er aktiv, og aldrig mens du skriver i søgefeltet."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Klicke auf einen Kurzbefehl und drücke dann die gewünschten Tasten. Kurzbefehle gelten, solange die Dateiliste aktiv ist, und nie während der Eingabe in der Suche."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Κάντε κλικ σε μια συντόμευση και πατήστε τα πλήκτρα που θέλετε. Οι συντομεύσεις ισχύουν όταν η λίστα αρχείων είναι ενεργή, ποτέ κατά την πληκτρολόγηση στην αναζήτηση."
          }
        },
        "en-AU" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Click a shortcut, then press the keys you want. Shortcuts apply while the file list is focused and never while typing in search."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Click a shortcut, then press the keys you want. Shortcuts apply while the file list is focused and never while typing in search."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Haz clic en una función rápida y pulsa las teclas que quieras. Las funciones rápidas se aplican cuando la lista de archivos está activa y nunca mientras escribes en la búsqueda."
          }
        },
        "es-419" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Haz clic en un atajo y presiona las teclas que quieras. Los atajos funcionan cuando la lista de archivos está activa y nunca mientras escribes en la búsqueda."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Klikkaa oikotietä ja paina sitten haluamiasi näppäimiä. Oikotiet toimivat, kun tiedostoluettelo on aktiivinen, mutta eivät koskaan hakuun kirjoitettaessa."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cliquez sur un raccourci, puis appuyez sur les touches souhaitées. Les raccourcis s’appliquent lorsque la liste des fichiers est active, jamais pendant la saisie d’une recherche."
          }
        },
        "fr-CA" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cliquez sur un raccourci, puis appuyez sur les touches souhaitées. Les raccourcis s’appliquent lorsque la liste des fichiers est active, jamais pendant la saisie d’une recherche."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "יש ללחוץ על קיצור ואז להקיש על המקשים הרצויים. הקיצורים פועלים כשרשימת הקבצים פעילה, ולעולם לא בזמן הקלדה בחיפוש."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "किसी शॉर्टकट पर क्लिक करें, फिर अपनी पसंद की कीज़ दबाएँ। शॉर्टकट तब काम करते हैं जब फ़ाइल सूची फ़ोकस में हो, और खोज में टाइप करते समय कभी नहीं।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kliknite prečac, a zatim pritisnite željene tipke. Prečaci rade dok je popis datoteka u fokusu, a nikad tijekom upisivanja u pretraživanje."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kattintson egy billentyűparancsra, majd nyomja le a kívánt billentyűket. A billentyűparancsok akkor működnek, ha a fájllista aktív, keresés közbeni gépeléskor soha."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Klik pintasan, lalu tekan tombol yang Anda inginkan. Pintasan berlaku saat daftar file difokuskan dan tidak pernah saat mengetik di pencarian."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fai clic su un’abbreviazione, quindi premi i tasti desiderati. Le abbreviazioni funzionano quando l’elenco dei file è attivo, mai mentre scrivi nel campo di ricerca."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ショートカットをクリックしてから、割り当てたいキーを押してください。ショートカットはファイルリストがフォーカスされているときに有効で、検索フィールドに入力中は無効です。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "단축키를 클릭한 다음 원하는 키를 누르십시오. 단축키는 파일 목록이 선택되어 있을 때 적용되며, 검색어를 입력하는 중에는 적용되지 않습니다."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Klik pintasan, kemudian tekan kekunci yang anda mahu. Pintasan berfungsi apabila senarai fail difokuskan dan tidak sesekali semasa menaip dalam carian."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Klikk på en snarvei, og trykk deretter på tastene du vil bruke. Snarveier gjelder når fillisten er aktiv, og aldri mens du skriver i søkefeltet."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Klik op een toetscombinatie en druk vervolgens op de gewenste toetsen. Toetscombinaties werken als de bestandenlijst actief is en nooit tijdens het typen in het zoekveld."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kliknij skrót, a następnie naciśnij wybrane klawisze. Skróty działają, gdy lista plików jest aktywna, i nigdy podczas wpisywania w polu wyszukiwania."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Clique em um atalho e pressione as teclas desejadas. Os atalhos funcionam quando a lista de arquivos está em foco e nunca enquanto você digita na busca."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Clique num atalho e prima as teclas pretendidas. Os atalhos funcionam quando a lista de ficheiros está em foco e nunca durante a escrita na pesquisa."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Faceți clic pe o scurtătură, apoi apăsați tastele dorite. Scurtăturile funcționează când lista de fișiere este activă, niciodată în timp ce scrieți în câmpul de căutare."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Нажмите на сочетание, затем нажмите нужные клавиши. Сочетания работают, когда активен список файлов, и не работают при вводе в поиске."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kliknite na skratku a stlačte požadované klávesy. Skratky fungujú, keď je aktívny zoznam súborov, a nikdy pri písaní do vyhľadávania."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Klicka på ett kortkommando och tryck sedan på de tangenter du vill använda. Kortkommandon gäller när fillistan är aktiv och aldrig när du skriver i sökfältet."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "คลิกปุ่มลัด แล้วกดปุ่มที่คุณต้องการ ปุ่มลัดจะทำงานเมื่อรายการไฟล์อยู่ในโฟกัส และจะไม่ทำงานขณะพิมพ์ในช่องค้นหา"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bir kestirmeyi tıklayın, sonra istediğiniz tuşlara basın. Kestirmeler dosya listesi etkinken çalışır, aramaya yazarken asla çalışmaz."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Клацніть скорочення, а потім натисніть потрібні клавіші. Скорочення діють, коли активний список файлів, і не діють під час введення в пошуку."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bấm vào một phím tắt, sau đó nhấn các phím bạn muốn. Phím tắt có tác dụng khi danh sách tệp đang được chọn và không bao giờ có tác dụng khi đang nhập vào ô tìm kiếm."
          }
        },
        "zh-HK" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "按一下快速鍵，然後按下你要的按鍵。快速鍵僅在檔案列表為焦點時作用，在搜尋欄位中輸入時不會作用。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "点按一个快捷键，然后按下想要的按键。快捷键仅在文件列表处于焦点时生效，在搜索栏中输入时不会生效。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "按一下快速鍵，然後按下你要的按鍵。快速鍵僅在檔案列表為焦點時作用，在搜尋欄位中輸入時不會作用。"
          }
        }
      }
    },
