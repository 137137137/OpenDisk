        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tato složka je prázdná, nebo v ní nebylo nic dost velkého ke skenování."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mappen er tom, eller intet i den var stort nok til at blive scannet."
