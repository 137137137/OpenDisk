    "Full Disk Access allows OpenDisk to analyze all files and folders on your system for accurate disk usage information." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يتيح الوصول الكامل إلى القرص لـ OpenDisk تحليل كل الملفات والمجلدات على نظامك للحصول على معلومات دقيقة عن استخدام القرص."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L’accés total al disc permet a OpenDisk analitzar tots els fitxers i carpetes del sistema per obtenir informació precisa sobre l’ús del disc."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Přístup k celému disku umožňuje aplikaci OpenDisk analyzovat všechny soubory a složky v systému a přesně určit využití disku."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Med fuld diskadgang kan OpenDisk analysere alle filer og mapper på dit system og give præcise oplysninger om diskforbruget."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mit Festplattenvollzugriff kann OpenDisk alle Dateien und Ordner auf deinem System analysieren und die Speichernutzung genau ermitteln."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Η Πλήρης πρόσβαση στον δίσκο επιτρέπει στο OpenDisk να αναλύει όλα τα αρχεία και τους φακέλους του συστήματός σας για ακριβή στοιχεία χρήσης δίσκου."
          }
        },
        "en-AU" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Full Disk Access allows OpenDisk to analyse all files and folders on your system for accurate disk usage information."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Full Disk Access allows OpenDisk to analyse all files and folders on your system for accurate disk usage information."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El acceso total al disco permite a OpenDisk analizar todos los archivos y carpetas del sistema para obtener información precisa sobre el uso del disco."
          }
        },
        "es-419" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El acceso total al disco permite que OpenDisk analice todos los archivos y carpetas del sistema para obtener información precisa sobre el uso del disco."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Täyden levyn käyttöoikeuden avulla OpenDisk voi analysoida kaikki järjestelmän tiedostot ja kansiot ja antaa tarkat tiedot levyn käytöstä."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L’accès complet au disque permet à OpenDisk d’analyser tous les fichiers et dossiers de votre système afin d’obtenir des informations précises sur l’utilisation du disque."
          }
        },
        "fr-CA" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L’accès complet au disque permet à OpenDisk d’analyser tous les fichiers et dossiers de votre système afin d’obtenir des informations précises sur l’utilisation du disque."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "גישה מלאה לדיסק מאפשרת ל-OpenDisk לנתח את כל הקבצים והתיקיות במערכת לקבלת מידע מדויק על השימוש בדיסק."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "फ़ुल डिस्क ऐक्सेस से OpenDisk आपके सिस्टम की सभी फ़ाइलों और फ़ोल्डर का विश्लेषण करके डिस्क उपयोग की सटीक जानकारी दे पाता है।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Potpuni pristup disku omogućuje aplikaciji OpenDisk analizu svih datoteka i mapa na sustavu radi točnih podataka o zauzeću diska."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A Teljes lemezhozzáférés lehetővé teszi, hogy az OpenDisk a rendszer összes fájlját és mappáját elemezze a pontos lemezhasználati adatokhoz."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Akses Disk Penuh memungkinkan OpenDisk menganalisis semua file dan folder di sistem Anda untuk informasi penggunaan disk yang akurat."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L’accesso completo al disco consente a OpenDisk di analizzare tutti i file e le cartelle del sistema per fornire informazioni precise sull’utilizzo del disco."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "フルディスクアクセスを許可すると、OpenDisk はシステム上のすべてのファイルとフォルダを分析し、正確なディスク使用状況を表示できます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "전체 디스크 접근 권한이 있으면 OpenDisk가 시스템의 모든 파일과 폴더를 분석하여 정확한 디스크 사용량 정보를 제공할 수 있습니다."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Akses Cakera Penuh membolehkan OpenDisk menganalisis semua fail dan folder pada sistem anda untuk maklumat penggunaan cakera yang tepat."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Med full disktilgang kan OpenDisk analysere alle filer og mapper på systemet og gi nøyaktig informasjon om diskbruken."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Met toegang tot volledige schijf kan OpenDisk alle bestanden en mappen op je systeem analyseren voor nauwkeurige gegevens over het schijfgebruik."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pełny dostęp do dysku pozwala OpenDisk analizować wszystkie pliki i katalogi w systemie, aby dokładnie określić zajętość dysku."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O Acesso Total ao Disco permite que o OpenDisk analise todos os arquivos e pastas do sistema para obter informações precisas sobre o uso do disco."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O acesso total ao disco permite ao OpenDisk analisar todos os ficheiros e pastas do sistema para obter informação precisa sobre a utilização do disco."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Accesul complet la disc permite OpenDisk să analizeze toate fișierele și dosarele din sistem pentru informații precise despre utilizarea discului."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Полный доступ к диску позволяет OpenDisk анализировать все файлы и папки в системе и точно определять использование диска."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Prístup k celému disku umožňuje aplikácii OpenDisk analyzovať všetky súbory a priečinky v systéme a presne určiť využitie disku."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Med fullständig skivåtkomst kan OpenDisk analysera alla filer och mappar i systemet och ge exakt information om skivanvändningen."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "การเข้าถึงดิสก์เต็มรูปแบบช่วยให้ OpenDisk วิเคราะห์ไฟล์และโฟลเดอร์ทั้งหมดในระบบของคุณเพื่อให้ข้อมูลการใช้ดิสก์ที่แม่นยำ"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tam Disk Erişimi, doğru disk kullanımı bilgisi için OpenDisk’in sisteminizdeki tüm dosya ve klasörleri analiz etmesini sağlar."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Повний доступ до диска дає змогу OpenDisk аналізувати всі файли й папки в системі та точно визначати використання диска."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Truy cập toàn bộ ổ đĩa cho phép OpenDisk phân tích tất cả tệp và thư mục trên hệ thống để cung cấp thông tin sử dụng ổ đĩa chính xác."
          }
        },
        "zh-HK" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "全磁碟取用權限可讓 OpenDisk 分析系統上的所有檔案和資料夾，以提供準確的磁碟使用量資料。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "完全磁盘访问权限可让 OpenDisk 分析系统上的所有文件和文件夹，从而提供准确的磁盘使用信息。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "全磁碟取用權限可讓 OpenDisk 分析系統上的所有檔案和檔案夾，以提供準確的磁碟使用量資訊。"
          }
        }
      }
    },
