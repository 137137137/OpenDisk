          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kun olet antanut käyttöoikeuden, tarkista se klikkaamalla ”Tarkista uudelleen”."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Après avoir accordé l’accès, cliquez sur « Vérifier à nouveau » pour confirmer."
          }
        },
        "fr-CA" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Après avoir accordé l’accès, cliquez sur « Vérifier à nouveau » pour confirmer."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "לאחר מתן הגישה, יש ללחוץ על ”בדיקה חוזרת“ כדי לאמת."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ऐक्सेस देने के बाद, पुष्टि करने के लिए “फिर से जाँचें” पर क्लिक करें।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nakon dodjele pristupa kliknite „Provjeri ponovno” za potvrdu."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A hozzáférés megadása után kattintson az „Újraellenőrzés” gombra."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Setelah memberikan akses, klik “Periksa Lagi” untuk memverifikasi."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dopo aver concesso l’accesso, fai clic su “Controlla di nuovo” per verificare."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "アクセスを許可したら、「再確認」をクリックして確認してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
