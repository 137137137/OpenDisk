    "Quit %@ before deleting. Open apps can recreate their files." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "أنهِ %@ قبل الحذف. يمكن للتطبيقات المفتوحة إعادة إنشاء ملفاتها."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Surt de %@ abans d’eliminar. Les apps obertes poden tornar a crear els seus fitxers."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Před smazáním ukončete %@. Otevřené aplikace mohou své soubory znovu vytvořit."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Afslut %@, før du sletter. Åbne apps kan genskabe deres filer."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Beende %@ vor dem Löschen. Geöffnete Apps können ihre Dateien neu erstellen."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Τερματίστε το %@ πριν από τη διαγραφή. Οι ανοιχτές εφαρμογές μπορούν να δημιουργήσουν ξανά τα αρχεία τους."
          }
        },
        "en-AU" : {
          "stringUnit" : {
            "state" : "translated",
