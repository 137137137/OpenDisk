    "Items already inside a collected folder aren’t listed again." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "العناصر الموجودة بالفعل داخل مجلد مُجمَّع لا تُدرج مرة أخرى."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Els elements que ja són dins d’una carpeta recollida no es tornen a llistar."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Položky, které už jsou uvnitř shromážděné složky, se znovu nezobrazují."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Emner, der allerede ligger i en indsamlet mappe, vises ikke igen."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Objekte, die bereits in einem gesammelten Ordner liegen, werden nicht noch einmal aufgeführt."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Τα στοιχεία που βρίσκονται ήδη μέσα σε συλλεγμένο φάκελο δεν εμφανίζονται ξανά."
          }
        },
        "en-AU" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Items already inside a collected folder aren’t listed again."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Items already inside a collected folder aren’t listed again."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Los elementos que ya están dentro de una carpeta recopilada no se vuelven a mostrar."
          }
        },
        "es-419" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Los elementos que ya están dentro de una carpeta recopilada no se vuelven a mostrar."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kohteita, jotka ovat jo kerätyn kansion sisällä, ei luetella uudelleen."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les éléments déjà contenus dans un dossier collecté ne sont pas listés à nouveau."
          }
        },
        "fr-CA" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les éléments déjà contenus dans un dossier collecté ne sont pas listés à nouveau."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "פריטים שכבר נמצאים בתוך תיקייה שנאספה לא מוצגים שוב."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "जो आइटम पहले से किसी एकत्रित फ़ोल्डर के अंदर हैं, वे दोबारा सूचीबद्ध नहीं होते।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Stavke koje se već nalaze u prikupljenoj mapi ne prikazuju se ponovno."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A már összegyűjtött mappán belüli elemek nem jelennek meg újra."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Item yang sudah berada di dalam folder yang dikumpulkan tidak ditampilkan lagi."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gli elementi già contenuti in una cartella raccolta non vengono elencati di nuovo."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "収集済みのフォルダ内にある項目は再度表示されません。"
          }
