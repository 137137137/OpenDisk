    "This folder is empty, or nothing in it was large enough to scan." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "هذا المجلد فارغ، أو لا يحتوي على شيء كبير بما يكفي لفحصه."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aquesta carpeta és buida o no conté res prou gran per analitzar-ho."
