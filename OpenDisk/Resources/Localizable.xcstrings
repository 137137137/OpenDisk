    "macOS denied access to this location. Check its permissions, or remove and re-grant it, then rescan." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "رفض macOS الوصول إلى هذا الموقع. تحقق من أذوناته، أو أزله وامنح الإذن مجددًا، ثم أعد الفحص."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El macOS ha denegat l’accés a aquesta ubicació. Comprova’n els permisos, o bé elimina-la i torna-hi a concedir accés, i després torna-la a analitzar."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "macOS odepřel přístup k tomuto umístění. Zkontrolujte jeho oprávnění nebo ho odeberte a znovu udělte přístup, pak skenujte znovu."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "macOS nægtede adgang til denne placering. Tjek tilladelserne, eller fjern adgangen, og giv den igen. Scan derefter igen."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "macOS hat den Zugriff auf diesen Ort verweigert. Prüfe die Berechtigungen oder entferne den Zugriff und erteile ihn erneut. Scanne anschließend noch einmal."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Το macOS αρνήθηκε την πρόσβαση σε αυτήν την τοποθεσία. Ελέγξτε τις άδειές της ή αφαιρέστε την και παραχωρήστε την ξανά και, στη συνέχεια, σαρώστε ξανά."
          }
        },
        "en-AU" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "macOS denied access to this location. Check its permissions, or remove and re-grant it, then rescan."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "macOS denied access to this location. Check its permissions, or remove and re-grant it, then rescan."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "macOS ha denegado el acceso a esta ubicación. Comprueba sus permisos, o elimínala y vuelve a conceder el acceso; después, vuelve a escanear."
          }
        },
        "es-419" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "macOS denegó el acceso a esta ubicación. Verifica sus permisos, o elimínala y vuelve a otorgar el acceso; luego, vuelve a escanear."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "macOS esti pääsyn tähän sijaintiin. Tarkista sen käyttöoikeudet tai poista käyttöoikeus ja anna se uudelleen. Skannaa sitten uudelleen."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "macOS a refusé l’accès à cet emplacement. Vérifiez ses autorisations, ou retirez-le et accordez de nouveau l’accès, puis relancez l’analyse."
          }
        },
        "fr-CA" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "macOS a refusé l’accès à cet emplacement. Vérifiez ses autorisations, ou retirez-le et accordez de nouveau l’accès, puis relancez l’analyse."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "macOS דחה את הגישה למיקום זה. יש לבדוק את ההרשאות שלו, או להסיר ולהעניק אותן מחדש, ואז לסרוק שוב."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "macOS ने इस लोकेशन का ऐक्सेस अस्वीकार कर दिया। इसकी अनुमतियाँ जाँचें, या इसे हटाकर फिर से अनुमति दें, फिर दोबारा स्कैन करें।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "macOS je odbio pristup ovoj lokaciji. Provjerite njezina dopuštenja ili je uklonite i ponovno dodijelite pristup, a zatim ponovno skenirajte."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A macOS megtagadta a hozzáférést ehhez a helyhez. Ellenőrizze az engedélyeit, vagy távolítsa el és adja meg újra, majd olvassa be újra."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "macOS menolak akses ke lokasi ini. Periksa izinnya, atau hapus dan berikan lagi, lalu pindai ulang."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "macOS ha negato l’accesso a questa posizione. Controllane i permessi, oppure rimuovila e concedi di nuovo l’accesso, quindi ripeti l’analisi."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "macOS によってこの場所へのアクセスが拒否されました。アクセス権を確認するか、いったん削除してから再度許可し、再スキャンしてください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "macOS가 이 위치에 대한 접근을 거부했습니다. 권한을 확인하거나, 제거한 후 다시 허용한 다음 다시 스캔하십시오."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "macOS menolak akses ke lokasi ini. Semak keizinannya, atau buang dan berikan semula, kemudian imbas semula."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "macOS nektet tilgang til denne plasseringen. Sjekk tillatelsene, eller fjern tilgangen og gi den på nytt, og skann deretter på nytt."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "macOS heeft toegang tot deze locatie geweigerd. Controleer de toegangsrechten of trek de toegang in en verleen deze opnieuw. Scan daarna opnieuw."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "macOS odmówił dostępu do tego miejsca. Sprawdź jego uprawnienia lub usuń i ponownie przyznaj dostęp, a następnie przeskanuj ponownie."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O macOS negou o acesso a este local. Verifique as permissões ou remova e conceda o acesso novamente e, depois, escaneie de novo."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O macOS negou o acesso a esta localização. Verifique as permissões ou remova-a e volte a conceder o acesso; depois, analise novamente."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "macOS a refuzat accesul la această locație. Verificați permisiunile acesteia sau eliminați-o și acordați din nou accesul, apoi scanați din nou."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "macOS запретила доступ к этому месту. Проверьте права доступа или удалите и снова предоставьте доступ, затем повторите сканирование."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "macOS zamietol prístup k tomuto umiestneniu. Skontrolujte jeho povolenia alebo ho odstráňte a znova udeľte prístup, potom znova skenujte."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "macOS nekade åtkomst till platsen. Kontrollera behörigheterna, eller ta bort åtkomsten och ge den igen, och skanna sedan om."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "macOS ปฏิเสธการเข้าถึงตำแหน่งนี้ ตรวจสอบการอนุญาตของตำแหน่งนี้ หรือเอาออกแล้วอนุญาตใหม่ จากนั้นสแกนอีกครั้ง"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "macOS bu konuma erişimi reddetti. İzinlerini denetleyin ya da kaldırıp yeniden izin verin, sonra yeniden tarayın."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "macOS заборонила доступ до цього розташування. Перевірте його дозволи або вилучіть і надайте доступ повторно, а потім проскануйте знову."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "macOS đã từ chối truy cập vị trí này. Hãy kiểm tra quyền của vị trí, hoặc xóa và cấp lại quyền, sau đó quét lại."
          }
        },
        "zh-HK" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "macOS 拒絕取用此位置。請檢查其權限，或將其移除後重新授權，然後重新掃描。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "macOS 拒绝访问此位置。请检查其权限，或将其移除后重新授权，然后重新扫描。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "macOS 拒絕取用此位置。請檢查其權限，或將其移除後重新授權，然後重新掃描。"
          }
        }
      }
    },
