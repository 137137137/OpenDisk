        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "OpenDisk funziona al meglio dalla cartella Applicazioni, necessaria per gli aggiornamenti automatici. L’app si sposterà e si riaprirà."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "OpenDisk はアプリケーションフォルダから実行するのが最適で、自動アップデートにも必要です。OpenDisk が自身を移動して再度開きます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "OpenDisk는 응용 프로그램 폴더에서 가장 잘 작동하며, 자동 업데이트를 사용하려면 이 위치에 있어야 합니다. OpenDisk가 스스로 이동한 후 다시 열립니다."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "OpenDisk berfungsi paling baik dari folder Aplikasi, dan kemas kini automatik memerlukannya. OpenDisk akan mengalihkan dirinya dan dibuka semula."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "OpenDisk fungerer best fra Programmer-mappen, og automatiske oppdateringer krever det. Appen flytter seg selv og åpnes på nytt."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "OpenDisk werkt het best vanuit de map Apps, en automatische updates vereisen dit. De app verplaatst zichzelf en wordt opnieuw geopend."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "OpenDisk działa najlepiej z katalogu Aplikacje, a automatyczne uaktualnienia tego wymagają. Aplikacja sama się przeniesie i otworzy ponownie."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O OpenDisk funciona melhor na pasta Aplicativos, e as atualizações automáticas exigem isso. Ele será movido e reaberto."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O OpenDisk funciona melhor na pasta Aplicações, e as atualizações automáticas exigem-no. A app irá mover-se e reabrir."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "OpenDisk funcționează cel mai bine din dosarul Aplicații, iar actualizările automate necesită acest lucru. Aplicația se va muta singură și se va redeschide."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "OpenDisk лучше всего работает из папки «Программы», и это требуется для автоматических обновлений. Программа переместится и откроется снова."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "OpenDisk funguje najlepšie z priečinka Aplikácie a automatické aktualizácie to vyžadujú. Aplikácia sa sama presunie a znova otvorí."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "OpenDisk fungerar bäst från mappen Program, och automatiska uppdateringar kräver det. Appen flyttar sig själv och öppnas igen."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "OpenDisk ทำงานได้ดีที่สุดจากโฟลเดอร์แอปพลิเคชัน และการอัปเดตอัตโนมัติจำเป็นต้องใช้โฟลเดอร์นี้ แอปจะย้ายตัวเองและเปิดใหม่"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "OpenDisk en iyi Uygulamalar klasöründe çalışır ve otomatik güncellemeler için bu gereklidir. Kendini taşıyıp yeniden açılacak."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "OpenDisk найкраще працює з папки «Програми», і цього потребують автоматичні оновлення. Програма переміститься і відкриється знову."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "OpenDisk hoạt động tốt nhất trong thư mục Ứng dụng và cần ở đó để cập nhật tự động. Ứng dụng sẽ tự di chuyển và mở lại."
          }
        },
        "zh-HK" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "OpenDisk 在「應用程式」資料夾中執行效果最佳，自動更新也需要如此。它會自行移動並重新打開。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "OpenDisk 在“应用程序”文件夹中运行效果最佳，自动更新也需要如此。它将自行移动并重新打开。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "OpenDisk 在「應用程式」檔案夾中執行效果最佳，自動更新也需要如此。它會自行搬移並重新打開。"
          }
        }
      }
    },
