    "Choose a disk in the sidebar. OpenDisk asks for access once and remembers it." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "اختر قرصًا من الشريط الجانبي. يطلب OpenDisk الوصول مرة واحدة ويتذكره."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tria un disc a la barra lateral. OpenDisk demana accés una sola vegada i ho recorda."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vyberte disk na bočním panelu. OpenDisk požádá o přístup jen jednou a zapamatuje si ho."
          }
        },
        "da" : {
          "stringUnit" : {
