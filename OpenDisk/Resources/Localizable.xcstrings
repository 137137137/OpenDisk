          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sau khi cấp quyền, bấm “Kiểm tra lại” để xác minh."
          }
        },
        "zh-HK" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "授予取用權限後，請按一下「再次檢查」來驗證。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
